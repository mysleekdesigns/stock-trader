// =============================================================================
// Opening Range Breakout (ORB) Indicator with Volume & VWAP Confirmation
// =============================================================================
// Triggers when ALL conditions are met:
//   1. Price closes above the 30-min opening range high (9:30-10:00 AM EST)
//   2. Bar volume >= 1.5x the average volume of the opening range
//   3. Price is above VWAP
//   4. Time is within the first 2 hours of session (before 11:30 AM EST)
// =============================================================================

//@version=5
indicator("ORB Breakout + Volume + VWAP", overlay=true, max_lines_count=500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
i_volumeMult   = input.float(1.5, "Volume Multiplier", minval=1.0, step=0.1,
                   tooltip="Bar volume must be >= this multiple of the opening range avg volume")
i_orbMinutes   = input.int(30, "Opening Range (minutes)", minval=5, step=5)
i_sessionEnd   = input.int(1130, "Signal Cutoff (HHMM EST)", minval=1000, maxval=1600,
                   tooltip="No new signals after this time")
i_orbLineColor = input.color(color.new(color.orange, 0), "OR High Line Color")
i_orbLineWidth = input.int(2, "OR High Line Width", minval=1, maxval=4)
i_bgColor      = input.color(color.new(color.green, 88), "Signal Background Color")

// ---------------------------------------------------------------------------
// Session & Time Helpers (all in America/New_York)
// ---------------------------------------------------------------------------
// Current bar's hour and minute in EST
estHour   = hour(time, "America/New_York")
estMinute = minute(time, "America/New_York")
estHHMM   = estHour * 100 + estMinute

// Key session boundaries
isMarketOpen    = not na(time(timeframe.period, "0930-1600", "America/New_York"))
isOpeningRange  = not na(time(timeframe.period, "0930-1000", "America/New_York"))
isSignalWindow  = isMarketOpen and estHHMM >= 1000 and estHHMM < i_sessionEnd

// Detect the first bar of a new trading day
newDay = ta.change(time("D")) != 0

// ---------------------------------------------------------------------------
// Track Opening Range High & Volume
// ---------------------------------------------------------------------------
var float orbHigh      = na   // Highest price during the opening range
var float orbVolSum    = 0.0  // Cumulative volume during the opening range
var int   orbBarCount  = 0    // Number of bars in the opening range
var float orbAvgVol    = na   // Average volume per bar in the opening range
var bool  orbComplete  = false
var bool  orbBreached  = false // Whether we already signaled today

// Reset everything at the start of each new trading day
if newDay
    orbHigh     := na
    orbVolSum   := 0.0
    orbBarCount := 0
    orbAvgVol   := na
    orbComplete := false
    orbBreached := false

// Build the opening range
if isOpeningRange
    orbHigh    := na(orbHigh) ? high : math.max(orbHigh, high)
    orbVolSum  += volume
    orbBarCount += 1

// Lock in the average volume once the opening range ends
if not isOpeningRange and not orbComplete and orbBarCount > 0
    orbAvgVol  := orbVolSum / orbBarCount
    orbComplete := true

// ---------------------------------------------------------------------------
// VWAP (built-in, anchored to session)
// ---------------------------------------------------------------------------
vwapValue = ta.vwap

// ---------------------------------------------------------------------------
// Signal Logic
// ---------------------------------------------------------------------------
// Bar must close in the top 50% of its range (strong buying pressure)
barRange        = high - low
closeInUpperHalf = barRange <= 0 or (close - low) >= 0.5 * barRange

breakoutCondition = orbComplete
                     and isSignalWindow
                     and close > orbHigh
                     and volume >= i_volumeMult * orbAvgVol
                     and close > vwapValue
                     and closeInUpperHalf

// Fire only on the first qualifying bar each day
signalFired = breakoutCondition and not orbBreached

if signalFired
    orbBreached := true

// ---------------------------------------------------------------------------
// Visuals: Opening Range High Line
// ---------------------------------------------------------------------------
var line orbLine = na

// Draw/extend the OR high line once the range is established
if orbComplete and not na(orbHigh)
    if na(orbLine) or newDay
        orbLine := line.new(x1=bar_index - orbBarCount, y1=orbHigh,
                             x2=bar_index, y2=orbHigh,
                             color=i_orbLineColor, width=i_orbLineWidth,
                             style=line.style_dashed, extend=extend.right)
    else
        line.set_x2(orbLine, bar_index)

// ---------------------------------------------------------------------------
// Visuals: Breakout Marker & Background
// ---------------------------------------------------------------------------
// Green triangle above the breakout bar
plotshape(signalFired, title="ORB Breakout",
           style=shape.triangleup, location=location.abovebar,
           color=color.green, size=size.small, text="ORB")

// Light green background when all conditions are active
bgcolor(breakoutCondition ? i_bgColor : na, title="Signal Background")

// Plot VWAP for reference
plot(vwapValue, "VWAP", color=color.new(color.blue, 30), linewidth=1)

// ---------------------------------------------------------------------------
// Alert
// ---------------------------------------------------------------------------
alertcondition(signalFired,
     title="ORB Breakout Alert",
     message='ORB Breakout: {{ticker}} | Price: {{close}} | Time: {{time}}')
